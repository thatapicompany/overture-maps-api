GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json
BIGQUERY_PROJECT_ID=your-GCP-project-id
GCS_BUCKET_NAME=your-GCS-bucket-name
AUTH_API_ACCESS_KEY=create-one-from-TheAuthAPI.com
ENABLE_ENRICHMENT=false
ENRICHMENT_ADAPTER_PACKAGE=
ENRICHMENT_FIELDS_ALLOWLIST=
ENRICHMENT_BQ_PROJECT=
ENRICHMENT_BQ_DATASET=
ENRICHMENT_BQ_TABLE=

# Usage / cost tracking (writes one immutable row per request to BigQuery)
USAGE_TRACKING_ENABLED=false
USAGE_BQ_PROJECT=
USAGE_BQ_DATASET=usage
USAGE_BQ_TABLE=api_requests
USAGE_FLUSH_INTERVAL_MS=2000
USAGE_FLUSH_MAX_ROWS=500

# Per-client rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# App-level result cache TTL in seconds (Overture data changes ~monthly; default 24h)
CACHE_TTL_SECONDS=86400

# Divisions search index (in-memory, loaded from GCS; falls back to BigQuery when absent)
# Build/refresh the artifact after each monthly Overture release: npm run etl:divisions-search-index
DIVISIONS_SEARCH_INDEX_ENABLED=true
DIVISIONS_SEARCH_INDEX_OBJECT=search-indexes/divisions-v1.ndjson.gz

# Wikidata brand enrichment (in-memory, loaded from GCS; ext_ brand fields are omitted when absent)
# Build/refresh the artifact monthly: npm run etl:brands-enrichment
BRANDS_ENRICHMENT_ENABLED=true
BRANDS_ENRICHMENT_OBJECT=enrichment/brands-v1.ndjson.gz

# Place tables (etl/bigquery-cost-controls.md). PLACE_TABLE is clustered by
# geometry and serves radius queries; PLACE_COUNTRY_TABLE is clustered by a
# top-level country column and serves queries with no lat/lng. Both default to
# unset: PLACE_TABLE falls back to the public table, and country-level queries
# fall back to PLACE_TABLE.
PLACE_TABLE=
PLACE_COUNTRY_TABLE=
BUILDING_TABLE=
# Id-clustered division_area mirror for GET /divisions/:id; unset reads the public table.
DIVISION_AREA_TABLE=

# Paid-only features (country-level /places) read the plan live from the
# account portal's Firestore: organizations/{accountId}.planId is the Stripe
# price; anything but a Free price with an active/trialing/past_due status is
# paid. Unknown (no doc, error, timeout) always ALLOWS. Runtime service account
# needs roles/datastore.viewer on the Firestore project.
PLAN_FIRESTORE_PROJECT_ID=overture-api
FREE_PLAN_PRICE_IDS=price_1RyU95Kqcwz1EdQWSn6vxFzs
PLAN_CACHE_TTL_MS=60000
PLAN_LOOKUP_TIMEOUT_MS=2500
# Static override: account ids always treated as paid, no lookup (enterprise
# deals, comped access, emergencies). Not needed for normal Stripe customers.
PAID_ACCOUNT_IDS=
